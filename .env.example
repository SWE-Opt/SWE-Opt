# Copy this template to .env in the repository root.
# Fill only the values needed by your selected provider/workflow.
# Never commit .env or real credentials. Empty values are not valid API keys.
# uv manages Python dependencies, not credentials; the application loads .env.

# Direct inference providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
ZHIPU_API_KEY=
HUGGINGFACE_API_KEY=

# The current Ollama client key lookup requires a nonempty value.
# For a local server without authentication, use a non-secret placeholder.
OLLAMA_API_KEY=

# OpenCode agentic inference
# The bundled opencode.docker.json references OPENAI_API_KEY above.
# For another provider, declare its {env:VARIABLE_NAME} in that config and
# add the corresponding value here. The runner forwards referenced variables
# to the container; it does not copy this .env file into the image.
# Configure provider endpoints and model selection in opencode.docker.json.

# Dataset access: optional for public datasets, required for private/gated data.
# HUGGINGFACE_API_KEY above is for inference, not dataset authentication.
HUGGINGFACE_TOKEN=
# Alternatives supported by the dataset loader:
# HF_TOKEN=
# HUGGINGFACE_HUB_TOKEN=

# BM25 repository retrieval
GITHUB_TOKEN=
# REPO_BASE_URL=https://github.com

# Optional provider-backed token counting settings
# GEMINI_MODEL=
# GEMINI_BASE_URL=
# ANTHROPIC_MODEL=
# ANTHROPIC_BASE_URL=
