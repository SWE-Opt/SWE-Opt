{
  "$schema": "https://opencode.ai/config.json",
  "model": "public/gpt-4o",
  "enabled_providers": ["public"],
  "autoupdate": false,
  "permission": {
    "external_directory": "deny",
    "bash": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "steps": 50
    }
  },
  "provider": {
    "public": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Public OpenAI-compatible API",
      "options": {
        "baseURL": "https://api.openai.com/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-4o": {
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "share": "disabled"
}